{
  "manifest_version": 3,
  "name": "Test on Prod 🗿",
  "version": "1.0.0",
  "description": "Label test files and collapse or expand only tests in GitHub pull requests.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
